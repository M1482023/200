{
  "title": "Magnet to Google Drive",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "magnetUrl": {
      "title": "Magnet URL",
      "type": "string",
      "description": "Magnet link to download",
      "editor": "textfield"
    },
    "googleDrive": {
      "title": "Google Drive settings",
      "type": "object",
      "description": "OAuth credentials and folder settings",
      "editor": "json",
      "properties": {
        "clientId": {
          "title": "Client ID",
          "type": "string",
          "description": "Google OAuth client ID",
          "editor": "textfield"
        },
        "clientSecret": {
          "title": "Client Secret",
          "type": "string",
          "description": "Google OAuth client secret",
          "editor": "textarea"
        },
        "refreshToken": {
          "title": "Refresh Token",
          "type": "string",
          "description": "Google OAuth refresh token used to upload files",
          "editor": "textarea"
        },
        "folderId": {
          "title": "Folder ID (optional)",
          "type": "string",
          "description": "Google Drive folder where the ZIP will be uploaded",
          "editor": "textfield"
        }
      },
      "required": ["clientId", "clientSecret", "refreshToken"]
    }
  },
  "required": ["magnetUrl", "googleDrive"]
}
